# ======== الزامی ========
# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
# آیدی عددی مالک‌ها (از @userinfobot)، با کاما جدا. مالک‌ها به همه‌ی بخش‌ها دسترسی دارند.
ADMIN_IDS=123456789
# کلید از https://stard-market.ir/developers/dashboard
# sk_test_ = محیط آزمایشی (پول واقعی نیست) | sk_live_ = سفارش واقعی
STARD_API_KEY=sk_test_xxxxxxxxxxxxxxxx

# ======== پایگاه داده ========
# خالی = SQLite (مناسب ویندوز و شروع کار). برای Production: postgresql://user:pass@host:5432/db
DATABASE_URL=
DATABASE_PATH=data/shop.db
# فقط برای docker-compose (رمز پایگاه داده‌ی PostgreSQL)
POSTGRES_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=60

# ======== Redis (اختیاری؛ برای اجرای چند نمونه‌ی ربات لازم است) ========
# پروکسی تلگرام اگر تلگرام روی سرور فیلتر است (http://host:port یا socks5://user:pass@host:port)
TELEGRAM_PROXY=

REDIS_URL=

# ======== Stard ========
STARD_BASE_URL=https://stard-market.ir/api/v1
# IRT یا TON؛ خالی = منبع پیش‌فرض داشبورد
STARD_PAY_CURRENCY=IRT
# secret وب‌هوک (whsec_…) از داشبورد Stard؛ خالی = وب‌هوک خاموش، فقط polling
STARD_WEBHOOK_SECRET=

# ======== اجرا ========
# all = همه در یک پردازه | bot = فقط تلگرام | worker = فقط صف و کارهای پس‌زمینه
ROLE=all
WORKER_CONCURRENCY=8
MAX_CONCURRENT_PURCHASES=64
DEFAULT_PROFIT_PERCENT=10
POLL_INTERVAL_SECONDS=20
LOG_LEVEL=INFO
LOG_DIR=logs

# ======== پشتیبان ========
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# ======== سرور HTTP داخلی (/healthz، /metrics، وب‌هوک) ========
HTTP_ENABLED=true
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

# ======== به‌روزرسانی از GitHub ========
UPDATE_REPO=arad-afray/stard-shop-bot
# اختیاری؛ فقط اگر مخزن خصوصی است یا به سقف درخواست GitHub می‌خورید
GITHUB_TOKEN=
